FROM python:3.12-slim

# Prevent Python from writing bytecode files and buffering logs.
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH="/app:/app/backend"

# Application configuration defaults.
ENV APP_ENV=production
ENV API_HOST=0.0.0.0
ENV API_PORT=8000

WORKDIR /app

# Install only the required system packages.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency specification separately for Docker layer caching.
COPY requirements-freeze.txt .

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-freeze.txt

# Copy application source and required project files.
COPY backend ./backend
COPY frontend ./frontend
COPY .env.production.example ./.env.production.example

# Create a non-root user for application execution.
RUN groupadd --system appgroup \
    && useradd --system --gid appgroup --create-home appuser \
    && chown -R appuser:appgroup /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s \
    --timeout=5s \
    --start-period=30s \
    --retries=3 \
    CMD curl --fail http://127.0.0.1:8000/health || exit 1

# Use production ASGI server configuration.
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]